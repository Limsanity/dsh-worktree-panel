{
  "name": "@lim324/dsh-worktree-panel",
  "description": "Worktree + git branch management panel for the DSH Web GUI: orca-style project -> worktree -> sessions tree in the sidebar, with branch/worktree create, open and cleanup backed by real git worktrees and the DSH workspace registry.",
  "version": "0.1.4",
  "scripts": {
    "build": "node lib/build.mjs",
    "test": "node test/host-tools.mjs && node test/host-session-continue.mjs && node test/client-smoke.mjs && node test/render-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  }
}
